      "title": "IPv4/IPv6アドレス設定",
      "description": "ガイドラインR1/R2間でのIPv4およびIPv6アドレスを設定してください。",
      "devices": [
        {
          "name": "R1",
          "description": "",
          "requiredCommands": [
            "int e0/0",
            "ip address 10.0.12.5 255.255.255.252",
            "ipv6 address 2001:db8:12::1/126",
            "no shut"
          ]
        },
        {
          "name": "R2",
          "description": "",
          "requiredCommands": [
            "no shut",
            "int e0/0",
            "ip address 10.0.12.6 255.255.255.252",
            "ipv6 address 2001:db8:12::3/126",
            "no shut"
          ]
