    {
      "id": "sim-03",
      "title": "OSPF設定",
      "description": "ガイドラインネットワークのOSPFルーティングを設定してください。",
      "devices": [
        {
          "name": "R1",
          "description": "",
          "requiredCommands": [
            "clear ip ospf process",
            "y"
          ]
        },
        {
          "name": "R2",
          "description": "",
          "requiredCommands": [
            "router ospf 10",
            "router-id 10.2.2.2",
            "router ospf 10",
            "network 10.2.2.2 0.0.0.0 area 0",
            "network 10.0.12.0 0.0.0.3 area 0",
            "network 10.0.23.0 0.0.0.15 area 0",
            "int range e0/0 - 1",
            "ip ospf priority 255",
            "clear ip ospf process",
            "y"
          ]
        }
      ],
      "imagePath": "images/sim-topology-03.png"
    },
    {
      "id": "sim-04",
      "title": "問題4：Data VLAN/Voice VLAN/LLDP設定",
      "description": "SW1とSW2にデータVLAN(77: User_VLAN)とVoiceVLAN(177: Voice_VLAN)を作成してください。\ne0/1〜e0/3をアクセスポートとして設定し、VLAN 77をデータVLAN、VLAN 177をVoice VLANに割り当ててください。\nLLDPを有効化し、e0/0でlldp transmit / lldp receiveを設定してください。",
      "devices": [
        {
          "name": "SW1",
          "description": "",
          "requiredCommands": [
            "en",
            "conf t",
            "vlan 77",
            "name User_VLAN",
            "exit",
            "vlan 177",
            "name Voice_VLAN",
            "exit",
            "int range e0/1 - 3",
            "switchport mode access",
            "switchport access vlan 77",
            "switchport voice vlan 177",
            "exit",
            "lldp run",
            "int e0/0",
            "lldp transmit",
            "lldp receive",
            "end",
            "copy run start"
          ]
        },
        {
          "name": "SW2",
          "description": "",
          "requiredCommands": [
            "en",
            "conf t",
            "vlan 77",
            "name User_VLAN",
            "exit",
            "vlan 177",
            "name Voice_VLAN",
            "exit",
            "int range e0/1 - 3",
            "switchport mode access",
            "switchport access vlan 77",
            "switchport voice vlan 177",
            "exit",
            "lldp run",
            "int e0/0",
            "lldp transmit",
            "lldp receive",
            "end",
            "copy run start"
          ]
        }
      ]
    },
    {
      "id": "sim-05",
      "title": "VLANとLLDP構成",
      "description": "ガイドラインネットワーク内のデバイス間の接続を確認し、VLANとLLDPを適切に構成してください。",
      "devices": [
        {
          "name": "SW-1",
          "description": "",
          "requiredCommands": [
            "vlan 35",
            "name SALES",
            "int e0/2",
            "switchport mode access",
            "switchport access vlan 35",
            "lldp run",
            "int e0/2",
            "no lldp transmit",
            "no lldp receive"
          ]
        },
        {
          "name": "SW-2",
          "description": "",
          "requiredCommands": [
            "vlan 39",
            "name MARKETING",
            "int e0/2",
            "switchport mode access",
            "switchport access vlan 39",
            "lldp run"
          ]
        }
      ],
      "imagePath": "images/sim-topology-05.png"
    },
    {
      "id": "sim-06",
      "title": "問題6：NAT・NTP・DHCPリレー・SSH設定",
      "description": "R2にNAT設定（e0/1: inside, e0/0: outside, ACL 10でPAT）を行ってください。\nSW1にNTPサーバ(10.2.2.2)、VLAN 101でDHCPリレー(10.0.12.2)、ドメイン名(2048.ccna.com)、RSA 2048bit、SSHv2、adminユーザ、vtyラインをSSHのみに設定してください。",
      "devices": [
        {
          "name": "R2",
          "description": "",
          "requiredCommands": [
            "en",
            "conf t",
            "int e0/1",
            "ip nat inside",
            "exit",
            "int e0/0",
            "ip nat outside",
            "exit",
            "access-list 10 permit 10.0.12.0 0.0.0.3",
            "ip nat inside source list 10 int e0/0 overload",
            "end",
            "copy run start"
          ]
        },
        {
          "name": "SW1",
          "description": "",
          "requiredCommands": [
            "en",
            "conf t",
            "ntp server 10.2.2.2",
            "int vlan 101",
            "ip helper-address 10.0.12.2",
            "exit",
            "ip domain-name 2048.ccna.com",
            "crypto key generate rsa modulus 2048",
            "ip ssh version 2",
            "username admin privilege 15 secret cisco",
            "line vty 0 15",
            "transport input ssh",
            "login local",
            "end",
            "copy run start"
          ]
        }
      ]
    },
    {
      "id": "sim-07",
      "title": "問題7：CDP制御・VLAN 20/30・アクセスポート設定",
      "description": "SW-1でCDPをグローバル有効化し、e0/0のみCDP有効・e0/1〜e0/2はCDP無効にしてください。\nSW-2にVLAN 30(SALES)とVLAN 20を作成し、e0/2をVLAN 20・e0/3をVLAN 30のアクセスポートに設定してください。",
      "devices": [
        {
          "name": "SW-1",
          "description": "",
          "requiredCommands": [
            "en",
            "conf t",
            "cdp run",
            "int e0/0",
            "cdp enable",
            "exit",
            "int range e0/1 - 2",
            "no cdp enable",
            "end",
            "copy run start"
          ]
        },
        {
          "name": "SW-2",
          "description": "",
          "requiredCommands": [
            "en",
            "conf t",
            "vlan 30",
            "name SALES",
            "exit",
            "vlan 20",
            "exit",
            "int e0/2",
            "switchport mode access",
            "switchport access vlan 20",
            "exit",
            "int e0/3",
            "switchport mode access",
            "switchport access vlan 30",
            "end",
            "copy run start"
          ]
        }
      ]
    },
